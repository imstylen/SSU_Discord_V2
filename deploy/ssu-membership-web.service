[Unit]
Description=SSU membership web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ssu-membership
Group=ssu-membership
WorkingDirectory=/opt/ssu-membership
ExecStart=/opt/ssu-membership/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8010 --workers 1 --proxy-headers --forwarded-allow-ips 127.0.0.1 --no-access-log
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/ssu-membership/data

[Install]
WantedBy=multi-user.target
